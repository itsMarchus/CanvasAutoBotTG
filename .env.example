# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Canvas Instance URL (e.g. https://your_school.instructure.com/ or your university's Canvas URL)
CANVAS_BASE_URL=https://your_school.instructure.com/

# Canvas Access Token (Generated from Canvas: Account -> Settings -> New Access Token)
CANVAS_ACCESS_TOKEN=your_canvas_access_token_here

# (Optional) Security: Pin your personal Telegram numeric User ID to restrict access
# Find your ID using @userinfobot on Telegram. If left blank, the first user who runs /start is saved as owner.
TELEGRAM_ALLOWED_USER_ID=

# Background Poll Cron Schedule (default: every 10 minutes)
POLL_INTERVAL_CRON=*/10 * * * *

# Timezone for date formatting and reminders (e.g. America/New_York, Asia/Manila, UTC)
TIMEZONE=Asia/Manila

# Supabase PostgreSQL Database (for 24/7 cloud deduplication & state)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Gemini AI API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest